# Copy to .env.local for local `vercel dev`, or set these as Vercel project env vars.

# Gemini API key used to draft FAQ text per cluster (https://aistudio.google.com/apikey).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Populated automatically once the Vercel Postgres (Neon) integration is attached.
# For local dev without Vercel Postgres, leave unset to fall back to a local SQLite file.
POSTGRES_URL=
