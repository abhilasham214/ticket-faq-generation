{
  "info": {
    "name": "Ticket FAQ Auto Builder API",
    "description": "Functional, negative, and edge-case coverage for the Knowledge Base FAQ Auto Builder API. There is no server-side state between requests, so every request in this collection is independent and can be run in any order (individually, top to bottom, or via the Collection Runner / newman).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /api/health",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/health", "host": ["{{baseUrl}}"], "path": ["api", "health"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('status is ok', () => pm.expect(body.status).to.eql('ok'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Generate FAQs",
      "item": [
        {
          "name": "POST /api/faqs/generate - valid CSV (functional)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": "data/sample_tickets.csv" }
              ]
            },
            "url": { "raw": "{{baseUrl}}/api/faqs/generate", "host": ["{{baseUrl}}"], "path": ["api", "faqs", "generate"] },
            "description": "In the Postman GUI, re-select data/sample_tickets.csv for the 'file' field (Postman requires re-attaching local files for security). Via newman, run from the repo root so the relative src resolves."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('total_tickets is 20', () => pm.expect(body.total_tickets).to.eql(20));",
                  "pm.test('exactly 5 themes for the sample dataset', () => pm.expect(body.clusters.length).to.eql(5));",
                  "pm.test('cluster counts sum to total', () => {",
                  "  const sum = body.clusters.reduce((acc, c) => acc + c.ticket_count, 0);",
                  "  pm.expect(sum).to.eql(body.total_tickets);",
                  "});",
                  "pm.test('every cluster has a theme, keywords, traceable tickets, and a grounded FAQ', () => {",
                  "  body.clusters.forEach((c) => {",
                  "    pm.expect(c.theme).to.be.a('string').and.not.empty;",
                  "    pm.expect(c.theme).to.not.include('/');",
                  "    pm.expect(c.keywords).to.be.an('array');",
                  "    pm.expect(c.tickets.length).to.eql(c.ticket_count);",
                  "    pm.expect(c.faq.question).to.be.a('string').and.not.empty;",
                  "    pm.expect(c.faq.answer).to.be.a('string').and.not.empty;",
                  "    pm.expect(c.faq.resolution_steps).to.be.an('array');",
                  "  });",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Generate FAQs - negative & edge cases",
      "item": [
        {
          "name": "POST /api/faqs/generate - non-CSV file (negative)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "multipart/form-data; boundary=----WebKitFormBoundaryABC123" }
            ],
            "body": {
              "mode": "raw",
              "raw": "------WebKitFormBoundaryABC123\r\nContent-Disposition: form-data; name=\"file\"; filename=\"tickets.txt\"\r\nContent-Type: text/plain\r\n\r\nnot a csv file\r\n------WebKitFormBoundaryABC123--\r\n"
            },
            "url": { "raw": "{{baseUrl}}/api/faqs/generate", "host": ["{{baseUrl}}"], "path": ["api", "faqs", "generate"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('error mentions csv', () => pm.expect(pm.response.json().detail).to.match(/csv/i));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/faqs/generate - missing resolution column (negative)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "multipart/form-data; boundary=----WebKitFormBoundaryABC123" }
            ],
            "body": {
              "mode": "raw",
              "raw": "------WebKitFormBoundaryABC123\r\nContent-Disposition: form-data; name=\"file\"; filename=\"bad.csv\"\r\nContent-Type: text/csv\r\n\r\nid,subject\r\nT1,A\r\nT2,B\r\nT3,C\r\n------WebKitFormBoundaryABC123--\r\n"
            },
            "url": { "raw": "{{baseUrl}}/api/faqs/generate", "host": ["{{baseUrl}}"], "path": ["api", "faqs", "generate"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('error names the missing column', () => pm.expect(pm.response.json().detail).to.match(/resolution/i));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/faqs/generate - missing id column (negative)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "multipart/form-data; boundary=----WebKitFormBoundaryABC123" }
            ],
            "body": {
              "mode": "raw",
              "raw": "------WebKitFormBoundaryABC123\r\nContent-Disposition: form-data; name=\"file\"; filename=\"bad.csv\"\r\nContent-Type: text/csv\r\n\r\nsubject,resolution\r\nA,B\r\nC,D\r\nE,F\r\n------WebKitFormBoundaryABC123--\r\n"
            },
            "url": { "raw": "{{baseUrl}}/api/faqs/generate", "host": ["{{baseUrl}}"], "path": ["api", "faqs", "generate"] },
            "description": "A ticket identifier column (id / ticket_id / external_id) is required for source-ticket traceability."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('error names the missing id column', () => pm.expect(pm.response.json().detail).to.match(/id/i));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/faqs/generate - fewer than minimum tickets (negative)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "multipart/form-data; boundary=----WebKitFormBoundaryABC123" }
            ],
            "body": {
              "mode": "raw",
              "raw": "------WebKitFormBoundaryABC123\r\nContent-Disposition: form-data; name=\"file\"; filename=\"tiny.csv\"\r\nContent-Type: text/csv\r\n\r\nid,subject,resolution\r\nT1,Cannot log in,Reset session\r\nT2,Billed twice,Refunded charge\r\n------WebKitFormBoundaryABC123--\r\n"
            },
            "url": { "raw": "{{baseUrl}}/api/faqs/generate", "host": ["{{baseUrl}}"], "path": ["api", "faqs", "generate"] },
            "description": "At least 3 valid tickets are required to detect a recurring theme - never a 500, always a handled 4xx."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('never a 500', () => pm.expect(pm.response.code).to.not.eql(500));",
                  "pm.test('handled 4xx for too few tickets', () => pm.expect(pm.response.code).to.be.within(400, 499));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/faqs/generate - extra unrecognized columns (edge)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "multipart/form-data; boundary=----WebKitFormBoundaryABC123" }
            ],
            "body": {
              "mode": "raw",
              "raw": "------WebKitFormBoundaryABC123\r\nContent-Disposition: form-data; name=\"file\"; filename=\"extra.csv\"\r\nContent-Type: text/csv\r\n\r\nid,subject,resolution,priority\r\nT1,Cannot log in,Reset session,high\r\nT2,Billed twice,Refunded charge,low\r\nT3,API key expired,Issued new key,low\r\n------WebKitFormBoundaryABC123--\r\n"
            },
            "url": { "raw": "{{baseUrl}}/api/faqs/generate", "host": ["{{baseUrl}}"], "path": ["api", "faqs", "generate"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200 despite unknown column', () => pm.response.to.have.status(200));",
                  "pm.test('total_tickets is 3', () => pm.expect(pm.response.json().total_tickets).to.eql(3));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/faqs/generate - duplicate rows (edge)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "multipart/form-data; boundary=----WebKitFormBoundaryABC123" }
            ],
            "body": {
              "mode": "raw",
              "raw": "------WebKitFormBoundaryABC123\r\nContent-Disposition: form-data; name=\"file\"; filename=\"dupes.csv\"\r\nContent-Type: text/csv\r\n\r\nid,subject,resolution\r\nT1,Cannot log in,Reset session\r\nT2,Cannot log in,Reset session\r\nT3,Cannot log in,Reset session\r\n------WebKitFormBoundaryABC123--\r\n"
            },
            "url": { "raw": "{{baseUrl}}/api/faqs/generate", "host": ["{{baseUrl}}"], "path": ["api", "faqs", "generate"] },
            "description": "Identical subject/resolution text across distinct ticket ids should still cluster into one theme without erroring."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('total_tickets is 3', () => pm.expect(body.total_tickets).to.eql(3));",
                  "pm.test('at least one cluster', () => pm.expect(body.clusters.length).to.be.at.least(1));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
