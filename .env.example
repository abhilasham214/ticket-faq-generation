# Copy to .env.local for local `vercel dev`, or set these as Vercel project env vars.

# Gemini API key used to draft FAQ text per cluster (https://aistudio.google.com/apikey).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Vercel KV (Upstash Redis REST API) - persists user-approved custom
# categories (the "Add as new domain" popup) across deploys and cold
# starts. Attach a KV store to the Vercel project (Storage -> Create
# Database -> KV) to get these auto-injected, or `vercel env pull
# .env.local` to copy them down for local dev. Without these set, custom
# categories just aren't persisted - clustering/naming/generation still
# work fine using only the built-in taxonomy.
KV_REST_API_URL=
KV_REST_API_TOKEN=
