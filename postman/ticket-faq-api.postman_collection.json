{
  "info": {
    "name": "Ticket FAQ Auto Builder API",
    "description": "Functional, negative, and edge-case coverage for the Knowledge Base FAQ Auto Builder API. There is no server-side state between requests, so every request in this collection is independent and can be run in any order (individually, top to bottom, or via the Collection Runner / newman).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /api/health",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/health", "host": ["{{baseUrl}}"], "path": ["api", "health"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('status is ok', () => pm.expect(body.status).to.eql('ok'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Generate FAQs",
      "item": [
        {
          "name": "POST /api/faqs/generate - valid CSV (functional)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": "data/sample_tickets.csv" }
              ]
            },
            "url": { "raw": "{{baseUrl}}/api/faqs/generate", "host": ["{{baseUrl}}"], "path": ["api", "faqs", "generate"] },
            "description": "In the Postman GUI, re-select data/sample_tickets.csv for the 'file' field (Postman requires re-attaching local files for security). Via newman, run from the repo root so the relative src resolves."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('total_tickets is 20', () => pm.expect(body.total_tickets).to.eql(20));",
                  "pm.test('3 to 5 clusters', () => pm.expect(body.clusters.length).to.be.within(3, 5));",
                  "pm.test('cluster counts sum to total', () => {",
                  "  const sum = body.clusters.reduce((acc, c) => acc + c.ticket_count, 0);",
                  "  pm.expect(sum).to.eql(body.total_tickets);",
                  "});",
                  "pm.test('every cluster has a grounded FAQ', () => {",
                  "  body.clusters.forEach((c) => {",
                  "    pm.expect(c.faq.question).to.be.a('string').and.not.empty;",
                  "    pm.expect(c.faq.answer).to.be.a('string').and.not.empty;",
                  "  });",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Generate FAQs - negative & edge cases",
      "item": [
        {
          "name": "POST /api/faqs/generate - non-CSV file (negative)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "multipart/form-data; boundary=----WebKitFormBoundaryABC123" }
            ],
            "body": {
              "mode": "raw",
              "raw": "------WebKitFormBoundaryABC123\r\nContent-Disposition: form-data; name=\"file\"; filename=\"tickets.txt\"\r\nContent-Type: text/plain\r\n\r\nnot a csv file\r\n------WebKitFormBoundaryABC123--\r\n"
            },
            "url": { "raw": "{{baseUrl}}/api/faqs/generate", "host": ["{{baseUrl}}"], "path": ["api", "faqs", "generate"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('error mentions csv', () => pm.expect(pm.response.json().detail).to.match(/csv/i));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/faqs/generate - missing required columns (negative)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "multipart/form-data; boundary=----WebKitFormBoundaryABC123" }
            ],
            "body": {
              "mode": "raw",
              "raw": "------WebKitFormBoundaryABC123\r\nContent-Disposition: form-data; name=\"file\"; filename=\"bad.csv\"\r\nContent-Type: text/csv\r\n\r\nsubject,description\r\nA,B\r\n------WebKitFormBoundaryABC123--\r\n"
            },
            "url": { "raw": "{{baseUrl}}/api/faqs/generate", "host": ["{{baseUrl}}"], "path": ["api", "faqs", "generate"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('error names the missing column', () => pm.expect(pm.response.json().detail).to.match(/resolution/i));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/faqs/generate - no usable rows (negative)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "multipart/form-data; boundary=----WebKitFormBoundaryABC123" }
            ],
            "body": {
              "mode": "raw",
              "raw": "------WebKitFormBoundaryABC123\r\nContent-Disposition: form-data; name=\"file\"; filename=\"empty.csv\"\r\nContent-Type: text/csv\r\n\r\nsubject,description,resolution\r\n------WebKitFormBoundaryABC123--\r\n"
            },
            "url": { "raw": "{{baseUrl}}/api/faqs/generate", "host": ["{{baseUrl}}"], "path": ["api", "faqs", "generate"] },
            "description": "A valid header with zero data rows - never a 500, always a handled 4xx."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('never a 500', () => pm.expect(pm.response.code).to.not.eql(500));",
                  "pm.test('handled 4xx for no usable rows', () => pm.expect(pm.response.code).to.be.within(400, 499));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/faqs/generate - extra unrecognized columns (edge)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "multipart/form-data; boundary=----WebKitFormBoundaryABC123" }
            ],
            "body": {
              "mode": "raw",
              "raw": "------WebKitFormBoundaryABC123\r\nContent-Disposition: form-data; name=\"file\"; filename=\"extra.csv\"\r\nContent-Type: text/csv\r\n\r\nsubject,description,resolution,priority\r\nCannot log in,Password rejected,Reset session,high\r\nBilled twice,Duplicate charge,Refunded charge,low\r\n------WebKitFormBoundaryABC123--\r\n"
            },
            "url": { "raw": "{{baseUrl}}/api/faqs/generate", "host": ["{{baseUrl}}"], "path": ["api", "faqs", "generate"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200 despite unknown column', () => pm.response.to.have.status(200));",
                  "pm.test('total_tickets is 2', () => pm.expect(pm.response.json().total_tickets).to.eql(2));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/faqs/generate - duplicate + minimal rows (edge)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "multipart/form-data; boundary=----WebKitFormBoundaryABC123" }
            ],
            "body": {
              "mode": "raw",
              "raw": "------WebKitFormBoundaryABC123\r\nContent-Disposition: form-data; name=\"file\"; filename=\"dupes.csv\"\r\nContent-Type: text/csv\r\n\r\nsubject,description,resolution\r\nCannot log in,Password rejected,Reset session\r\nCannot log in,Password rejected,Reset session\r\n------WebKitFormBoundaryABC123--\r\n"
            },
            "url": { "raw": "{{baseUrl}}/api/faqs/generate", "host": ["{{baseUrl}}"], "path": ["api", "faqs", "generate"] },
            "description": "Exercises clustering's lower bound: only 2 tickets, below the usual 3-5 theme range, must still return a handled result (a single cluster), never a 500."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('total_tickets is 2', () => pm.expect(body.total_tickets).to.eql(2));",
                  "pm.test('at least one cluster', () => pm.expect(body.clusters.length).to.be.at.least(1));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
